# Template for local/CI Android release signing.
#
# Copy to android/app/key.properties (gitignored) to build a *signed* release
# APK/AAB. Absent by default: the release build then falls back to the debug key
# so `flutter run --release` still works. Tagged-release CI writes this file from
# repo secrets before building (see .github/workflows/release.yml).
#
# Create a keystore once next to this file, in android/app/ (never commit it):
#   keytool -genkey -v -keystore android/app/dvma-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias dvma
#
# storeFile is resolved relative to this key.properties (android/app/), so a bare
# filename means the .jks sits beside it.
storeFile=dvma-release.jks
storePassword=CHANGE_ME
keyAlias=dvma
keyPassword=CHANGE_ME

# Miscellaneous
*.class
*.lock
# DVMA is an application (publish_to: none), so pin the dependency graph:
# the resolved lockfile IS committed for reproducible CI/dev builds.
!pubspec.lock
*.log
*.pyc
__pycache__/
*.swp
.buildlog/
.history

# IDE / editor state (machine-specific; not committed)
.idea/
*.iml
*.ipr
*.iws
.vscode/
# macOS Finder metadata
.DS_Store
**/.DS_Store

# Flutter repo-specific
/bin/cache/
/bin/internal/bootstrap.bat
/bin/internal/bootstrap.sh
/bin/mingit/
/dev/benchmarks/mega_gallery/
/dev/bots/.recipe_deps
/dev/bots/android_tools/
/dev/devicelab/ABresults*.json
/dev/docs/doc/
/dev/docs/flutter.docs.zip
/dev/docs/lib/
/dev/docs/pubspec.yaml
/dev/integration_tests/**/xcuserdata
/dev/integration_tests/**/Pods
/packages/flutter/coverage/
version
analysis_benchmark.json

# packages file containing multi-root paths
.packages.generated

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
**/generated_plugin_registrant.dart
.packages
.pub-preload-cache/
.pub/
build/
flutter_*.png
linked_*.ds
unlinked.ds
unlinked_spec.ds

# Android related
# Note: the Gradle wrapper (gradle-wrapper.jar, gradlew, gradlew.bat) is
# intentionally committed for reproducible clone-and-build, matching the
# companion attacker project. Only build output and machine-local files below.
.gradle/
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
*.jks


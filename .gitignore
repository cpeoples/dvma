# Coverage
coverage/

# Symbols
app.*.symbols

# Exceptions to above rules.
!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3
!/packages/flutter_tools/test/data/dart_dependencies_test/**/.packages
!/dev/ci/**/Gemfile.lock
# Hugo docs build output and generated content
.hugo/public/
.hugo/public-linkcheck/
.hugo/content/
.hugo/resources/
.hugo/.hugo_build.lock
# llms.txt is generated by scripts/build_docs.py (like content/); regenerate it.
.hugo/static/llms.txt

# On-demand audit reports whose generators we keep but whose output we don't
# commit (regenerate to review coverage; nothing links to them). The kept audit,
# docs/ios_parity_audit.md, IS committed because the architecture "real-artifact
# guarantee" page links to it.
docs/evidence-matrix.md
docs/standards_mapping_audit.md

# Automation run output (regenerated by automation/scripts/*; never committed)
automation/artifacts/
automation/appium/artifacts/
# On-device pull output (SCP/tar from a rooted/jailbroken device). Large (GBs)
# and can contain machine-specific evidence (e.g. Team ID in keychain dumps).
automation/artifacts-ios-device/
automation/artifacts-android-device/

# root_pixel.sh output: the patched boot image and any kept downloads
# (Magisk APK / Google factory image). Device-specific + large; never commit.
magisk_patched.img
*-factory-*.zip
Magisk-*.apk
dvma-downloads/

# Flutter web scaffold: DVMA is Android + iOS only (see .metadata platforms).
# Tooling (flutter_native_splash / flutter create) can regenerate a partial
# web/ target; it's not a supported platform here, so never commit it.
/web/

# Cross-platform developer/OS cruft (targeted, so real source is never hidden).
# Windows Explorer:
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Python tooling (docs/registry helpers run under Python):
.pytest_cache/
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
# Coverage output beyond the coverage/ dir already ignored above:
*.lcov
# Xcode per-user UI state (xcuserdata/ already covered; be explicit for stragglers):
*.xcuserstate
